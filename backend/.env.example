# Copie para .env e preencha com valores próprios para cada ambiente.
# Nunca coloque credenciais reais neste arquivo ou no Git.
PORT=3002
JWT_SECRET=gere-uma-chave-aleatoria-longa-e-unica

# Configuração do Banco de Dados MySQL ('quem')
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_NAME=quem

# Cron: execução automática a cada 10 minutos por padrão.
SYNC_CRON_SCHEDULE="*/10 * * * *"
# Configure uma senha inicial segura para os novos usuários sincronizados.
DEFAULT_USER_PASSWORD=defina-uma-senha-inicial-segura
